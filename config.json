{
  "//": "Foco: aprender e aprimorar Gold/USD (frxXAUUSD) em conta demo. 2 estrategias, so este par.",

  "account": {
    "mode": "demo",
    "currency": "USD"
  },

  "risk": {
    "dailyStopLossPct": 8,
    "dailyTakeProfitPct": 12,
    "maxConcurrentBots": 5,
    "maxOpenContractsPerBot": 1,
    "hardFloorBalance": 5,
    "globalLossStreakPause": 6,
    "cooldownMinutes": 30
  },

  "learning": {
    "//": "Bandit Thompson + hill-climb + kill/probation. exploreTrades: 12 operacoes sem filtro por aposta p/ calibrar.",
    "enabled": true,
    "window": 40,
    "minSample": 25,
    "exploreTrades": 12,
    "killWinrate": 0.35,
    "probationStake": 0.5,
    "banditSafety": 1.0,
    "tuneStep": 0.1,
    "persistPath": "data/learn-state.json"
  },

  "ml": {
    "enabled": true,
    "pythonPath": "python",
    "scriptPath": "ml/predictor.py",
    "minEdge": 0.0
  },

  "session": {
    "dailyResetUtc": "00:00",
    "reconnect": { "pingIntervalSec": 20, "maxBackoffSec": 60 }
  },

  "alerts": {
    "//": "Telegram: preencha TELEGRAM_BOT_TOKEN e TELEGRAM_CHAT_ID no .env. heartbeatMinutes: 0 = sem resumo periodico.",
    "telegram": {
      "enabled": true,
      "onTradeOpen": true,
      "onTradeClose": true,
      "onBotStartStop": true,
      "onRiskEvent": true,
      "heartbeatMinutes": 240
    }
  },

  "bots": [
