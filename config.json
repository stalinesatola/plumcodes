      },
      "riskPerTradePct": 0.5,
      "daily": { "maxWins": 5, "maxLosses": 4, "maxTrades": 12 },
      "maxHoldMinutes": 45,
      "regimeAdx": { "period": 14, "max": 22 },
      "minMinutesBetweenTrades": 20,
      "manageStop": { "breakEvenAtR": 1.0, "trailAfterR": 1.2, "trailGapR": 0.6 },
