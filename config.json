{
  "//": "FOCO: só Gold/USD (frxXAUUSD). Vários setups no MESMO par para estudá-lo a fundo. O monitor mostra o relógio das 5 grandes praças (Sydney/Tokyo/Frankfurt/London/New York) como contexto — nenhum índice é operado.",

  "account": {
    "mode": "demo",
    "currency": "USD"
  },

  "risk": {
    "dailyStopLossPct": 8,
    "dailyTakeProfitPct": 12,
    "maxConcurrentBots": 3,
    "maxOpenContractsPerBot": 1,
    "hardFloorBalance": 5,
    "globalLossStreakPause": 6,
    "cooldownMinutes": 30
  },

  "learning": {
    "//": "Bandit Thompson + hill-climb + kill/probation. exploreTrades: 15 operacoes sem filtro por aposta p/ calibrar.",
    "enabled": true,
    "window": 40,
    "minSample": 25,
    "exploreTrades": 15,
    "killWinrate": 0.35,
    "probationStake": 0.5,
    "banditSafety": 1.0,
    "tuneStep": 0.1,
    "persistPath": "data/learn-state.json"
  },

  "ml": {
    "enabled": true,
    "pythonPath": "python",
    "scriptPath": "ml/predictor.py",
    "minEdge": 0.0
  },

  "session": {
    "dailyResetUtc": "00:00",
    "reconnect": { "pingIntervalSec": 20, "maxBackoffSec": 60 }
  },

  "alerts": {
    "//": "Telegram: preencha TELEGRAM_BOT_TOKEN e TELEGRAM_CHAT_ID no .env. heartbeatMinutes: 0 = sem resumo periodico.",
    "telegram": {
      "enabled": true,
      "onTradeOpen": true,
      "onTradeClose": true,
      "onBotStartStop": true,
      "onRiskEvent": true,
      "heartbeatMinutes": 240
    }
  },

  "bots": [
    {
      "//": "Reversao a media (Bollinger + RSI) na sessao de Londres. Bandas afrouxadas + janela alargada p/ ver mais entradas no estudo.",
      "id": "xau-meanrev-london",
      "enabled": true,
      "strategy": "gold_meanrev_london",
      "symbol": "frxXAUUSD",
      "durationTicks": 0,
      "stake": { "base": 2, "martingale": { "enabled": false, "factor": 2.0, "maxSteps": 2 } },
      "params": {
        "bbPeriod": 20,
        "bbK": 1.8,
        "rsiPeriod": 14,
        "rsiOb": 66,
        "rsiOs": 34,
        "stopAtrMult": 1.0,
        "tradeStart": 6,
        "tradeEnd": 14,
        "multiplier": 100,
        "rr": 1.5
      },
      "riskPerTradePct": 1,
      "daily": { "maxWins": 6, "maxLosses": 4, "maxTrades": 14 },
      "maxHoldMinutes": 45,
      "botStopLossUsd": 25,
      "botTakeProfitUsd": 35
    },
    {
      "//": "Momentum pos-abertura de NY. forceMult 1.6 -> 1.1 e janela 12-21 p/ gerar mais entradas (menor qualidade, mas e estudo em demo).",
      "id": "xau-ny-momo",
      "enabled": true,
      "strategy": "gold_ny_momo",
      "symbol": "frxXAUUSD",
      "durationTicks": 0,
      "stake": { "base": 2, "martingale": { "enabled": false, "factor": 2.0, "maxSteps": 2 } },
      "params": {
        "tradeStart": 12,
        "tradeEnd": 21,
        "forceMult": 1.1,
        "stopAtrMult": 1.0,
        "multiplier": 100,
        "rr": 1.5
      },
      "riskPerTradePct": 1,
      "daily": { "maxWins": 6, "maxLosses": 4, "maxTrades": 14 },
      "maxHoldMinutes": 30,
      "botStopLossUsd": 25,
      "botTakeProfitUsd": 35
    },
    {
      "//": "Reversao a media 24h (mesma logica, sem filtro de sessao) — gera muitas entradas p/ estudar o comportamento do ouro nas horas mortas tambem.",
      "id": "xau-meanrev-24h",
      "enabled": true,
      "strategy": "gold_meanrev_london",
      "symbol": "frxXAUUSD",
      "durationTicks": 0,
      "stake": { "base": 1, "martingale": { "enabled": false, "factor": 2.0, "maxSteps": 2 } },
      "params": {
        "bbPeriod": 20,
        "bbK": 2.0,
        "rsiPeriod": 14,
        "rsiOb": 70,
        "rsiOs": 30,
        "stopAtrMult": 1.0,
        "tradeStart": 0,
        "tradeEnd": 24,
        "multiplier": 100,
        "rr": 1.5
      },
      "riskPerTradePct": 0.5,
      "daily": { "maxWins": 8, "maxLosses": 5, "maxTrades": 20 },
      "maxHoldMinutes": 40,
      "botStopLossUsd": 15,
      "botTakeProfitUsd": 25
    }
  ]
}
