{
  "//": "Foco: aprender e aprimorar Gold/USD (frxXAUUSD) em conta demo. 2 estrategias, so este par.",

  "account": {
    "mode": "demo",
    "currency": "USD"
  },

  "risk": {
    "dailyStopLossPct": 8,
    "dailyTakeProfitPct": 12,
    "maxConcurrentBots": 2,
    "maxOpenContractsPerBot": 1,
    "hardFloorBalance": 5,
    "globalLossStreakPause": 6,
    "cooldownMinutes": 30
