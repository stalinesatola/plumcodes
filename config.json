      "enabled": true,
      "strategy": "gold_meanrev_london",
      "symbol": "frxXAUUSD",
      "durationTicks": 0,
      "stake": { "base": 1, "pctOfBalance": 5, "martingale": { "enabled": false, "factor": 2.0, "maxSteps": 2 } },
      "params": {
