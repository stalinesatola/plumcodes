{
  "name": "deriv-quant-research",
  "version": "1.0.0",
  "description": "Framework para construir, backtestar e correr estratégias algorítmicas na Deriv — com um loop de investigação honesto sobre expectancy.",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "monitor": "node --env-file=.env tools/dashboard.ts",
    "typecheck": "tsc --noEmit",
    "docs:image": "node tools/render-svg.ts docs/dashboard.svg"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
